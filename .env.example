DATABASE_URL="postgresql://localhost:5432/setflow"
# Production (Vercel + Supabase) uses POSTGRES_PRISMA_URL / POSTGRES_URL from the integration.
PORT=3001

# Signs session cookies. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, sessions fall back to a key derived from DATABASE_URL.
AUTH_SECRET=""

# Optional: seed the admin on boot instead of using the first-run screen.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ADMIN_NAME=""
