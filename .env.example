DATABASE_URL="file:./setflow.db"
PORT=3001

# Production (Vercel): songs written to /tmp disappear on the next serverless start.
# Pick one durable backend:

# GitHub (uses this repo, no extra database account):
# Create a fine-grained PAT with Contents read/write on uxedward/worshipsetlist,
# then add it in Vercel → Settings → Environment Variables.
# GITHUB_DATABASE_TOKEN="github_pat_..."
# Optional overrides:
# GITHUB_DATABASE_REPO="uxedward/worshipsetlist"
# GITHUB_DATABASE_BRANCH="setflow-data"
# GITHUB_DATABASE_PATH="data/setflow.db"

# Turso / libSQL (hosted SQLite):
# Create a free database at https://turso.tech then paste:
# TURSO_DATABASE_URL="libsql://YOUR-DB.turso.io"
# TURSO_AUTH_TOKEN="YOUR-TOKEN"
