{
  "buildCommand": "DATABASE_URL=\"file:./setflow.db\" prisma generate && vite build --config client/vite.config.ts",
  "outputDirectory": "client/dist",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{prisma/setflow.db,prisma/schema.prisma,node_modules/.prisma/client/**,node_modules/@prisma/engines/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ]
}
